@page "/"
@using System.ComponentModel.DataAnnotations
@using Heimdall.Web.Services
@using Microsoft.JSInterop
@inject AuthService AuthService
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Heimdall - Login</PageTitle>

<div class="main-container">
    <div class="login-container">
        <div class="login-card">
        <div class="login-header">
            <div class="logo-container">
                <svg class="logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
            </div>
            <h1 class="login-title">Heimdall</h1>
            <p class="login-subtitle">Guardian of Secure Access 🛡️</p>
            <p class="login-version">v1.0.0 - CI/CD Enabled</p>
        </div>

        <EditForm Model="@model" OnValidSubmit="@HandleLogin" class="login-form">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    <svg class="alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                    @errorMessage
                </div>
            }

            <div class="form-group">
                <label for="email" class="form-label">Email</label>
                <div class="input-group">
                    <span class="input-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                    </span>
                    <InputText id="email" @bind-Value="model.Email" class="form-control" placeholder="admin@heimdall.com" />
                </div>
                <ValidationMessage For="@(() => model.Email)" class="validation-message" />
            </div>

            <div class="form-group">
                <label for="password" class="form-label">Password</label>
                <div class="input-group">
                    <span class="input-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                        </svg>
                    </span>
                    <InputText id="password" type="@passwordInputType" @bind-Value="model.Password" class="form-control" placeholder="••••••••" />
                    <button type="button" class="password-toggle-btn" @onclick="TogglePasswordVisibility" title="@(showPassword ? "Hide password" : "Show password")">
                        @if (showPassword)
                        {
                            @* Eye Slash Icon - Password visible *@
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                            </svg>
                        }
                        else
                        {
                            @* Eye Icon - Password hidden *@
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                        }
                    </button>
                </div>
                <ValidationMessage For="@(() => model.Password)" class="validation-message" />
            </div>

            <div class="form-group">
                <label for="audience" class="form-label">Project</label>
                <div class="input-group">
                    <span class="input-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                        </svg>
                    </span>
                    <InputText id="audience" @bind-Value="model.Audience" class="form-control" placeholder="heimdall-api" />
                </div>
                <ValidationMessage For="@(() => model.Audience)" class="validation-message" />
            </div>

            <button type="submit" class="btn-login" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner"></span>
                    <span>Authenticating...</span>
                }
                else
                {
                    <span>Sign In</span>
                    <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                }
            </button>
        </EditForm>

        <div class="login-footer">
            <p class="footer-text">
                Protected by Heimdall Authentication System
            </p>
        </div>
    </div>
</div>
</div>

@code {
    private LoginModel model = new();
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private bool showPassword = false;
    private string passwordInputType => showPassword ? "text" : "password";

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            Console.WriteLine($"[Home] Starting login for {model.Email}");
            var result = await AuthService.LoginAsync(model.Email, model.Password, model.Audience);

            if (result != null)
            {
                Console.WriteLine("[Home] Login successful, storing tokens");
                // Login bem-sucedido - armazenar token e marcar usuário autenticado
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "accessToken", result.AccessToken);
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "refreshToken", result.RefreshToken);

                // Atualizar estado de autenticação
                AuthStateProvider.MarkUserAsAuthenticated(model.Email, result.AccessToken);

                Console.WriteLine("[Home] Redirecting to dashboard");
                // Redirecionar para o dashboard
                Navigation.NavigateTo("/dashboard", forceLoad: true);
            }
            else
            {
                Console.WriteLine("[Home] Login failed - null result");
                errorMessage = "Invalid credentials. Please check your email, password, and project.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Home] Exception during login: {ex.GetType().Name}: {ex.Message}");
            errorMessage = $"An error occurred during authentication: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Invalid email format")]
        public string Email { get; set; } = "admin@heimdall.com";

        [Required(ErrorMessage = "Password is required")]
        [MinLength(6, ErrorMessage = "Password must be at least 6 characters")]
        public string Password { get; set; } = "Admin@123!Dev";

        [Required(ErrorMessage = "Project is required")]
        public string Audience { get; set; } = "heimdall-api";
    }
}
