@page "/dashboard"

<PageTitle>Dashboard</PageTitle>

<div class="dashboard-container">
	<div class="dashboard-header">
		<h2>Bem-vindo, Diego!</h2>
		<span class="dashboard-date">@DateTime.Now.ToString("dd/MM/yyyy")</span>
	</div>
	<div class="dashboard-cards">
		<div class="card">
			<div class="card-title">Usuários Ativos</div>
			<div class="card-value">1.245</div>
			<div class="card-desc">+5% este mês</div>
		</div>
		<div class="card">
			<div class="card-title">Acessos Hoje</div>
			<div class="card-value">312</div>
			<div class="card-desc">+12% vs ontem</div>
		</div>
		<div class="card">
			<div class="card-title">Erros Reportados</div>
			<div class="card-value error">3</div>
			<div class="card-desc">-2 desde ontem</div>
		</div>
	</div>
	<div class="dashboard-charts">
		<div class="chart-card">
			<div class="chart-title">Acessos na Semana</div>
			<svg width="100%" height="80" viewBox="0 0 300 80">
				<polyline fill="none" stroke="#4f8cff" stroke-width="3" points="0,60 50,40 100,30 150,50 200,20 250,35 300,10" />
				<circle cx="300" cy="10" r="4" fill="#4f8cff" />
			</svg>
		</div>
		<div class="chart-card">
			<div class="chart-title">Erros por Dia</div>
			<svg width="100%" height="80" viewBox="0 0 300 80">
				<rect x="10" y="50" width="30" height="30" fill="#ff6b6b" />
				<rect x="60" y="30" width="30" height="50" fill="#ff6b6b" />
				<rect x="110" y="60" width="30" height="20" fill="#ff6b6b" />
				<rect x="160" y="40" width="30" height="40" fill="#ff6b6b" />
				<rect x="210" y="20" width="30" height="60" fill="#ff6b6b" />
			</svg>
		</div>
	</div>
	<div class="dashboard-table">
		<div class="table-title">Últimos Eventos</div>
		<table>
			<thead>
				<tr>
					<th>Data</th>
					<th>Usuário</th>
					<th>Ação</th>
					<th>Status</th>
				</tr>
			</thead>
			<tbody>
				<tr>
					<td>24/03/2026</td>
					<td>alice</td>
					<td>Login</td>
					<td><span class="status success">Sucesso</span></td>
				</tr>
				<tr>
					<td>24/03/2026</td>
					<td>bob</td>
					<td>Logout</td>
					<td><span class="status warning">Aviso</span></td>
				</tr>
				<tr>
					<td>24/03/2026</td>
					<td>carol</td>
					<td>Erro de autenticação</td>
					<td><span class="status error">Erro</span></td>
				</tr>
			</tbody>
		</table>
	</div>
</div>

<style>
.dashboard-container {
	max-width: 900px;
	margin: 2rem auto;
	padding: 2rem;
	background: #f9fafe;
	border-radius: 18px;
	box-shadow: 0 4px 32px rgba(0,0,0,0.08);
	font-family: 'Segoe UI', Arial, sans-serif;
}
.dashboard-header {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 2rem;
}
.dashboard-header h2 {
	font-size: 2rem;
	font-weight: 600;
	color: #222;
}
.dashboard-date {
	color: #888;
	font-size: 1rem;
}
.dashboard-cards {
	display: flex;
	gap: 1.5rem;
	margin-bottom: 2rem;
}
.card {
	flex: 1;
	background: #fff;
	border-radius: 12px;
	box-shadow: 0 2px 12px rgba(79,140,255,0.07);
	padding: 1.5rem 1rem;
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	gap: 0.5rem;
}
.card-title {
	font-size: 1rem;
	color: #888;
}
.card-value {
	font-size: 2rem;
	font-weight: 700;
	color: #4f8cff;
}
.card-value.error {
	color: #ff6b6b;
}
.card-desc {
	font-size: 0.95rem;
	color: #aaa;
}
.dashboard-charts {
	display: flex;
	gap: 1.5rem;
	margin-bottom: 2rem;
}
.chart-card {
	flex: 1;
	background: #fff;
	border-radius: 12px;
	box-shadow: 0 2px 12px rgba(79,140,255,0.07);
	padding: 1rem;
}
.chart-title {
	font-size: 1rem;
	color: #888;
	margin-bottom: 0.5rem;
}
.dashboard-table {
	background: #fff;
	border-radius: 12px;
	box-shadow: 0 2px 12px rgba(79,140,255,0.07);
	padding: 1rem;
}
.table-title {
	font-size: 1.1rem;
	font-weight: 600;
	margin-bottom: 0.5rem;
}
table {
	width: 100%;
	border-collapse: collapse;
}
th, td {
	padding: 0.7rem 0.5rem;
	text-align: left;
}
th {
	color: #4f8cff;
	font-weight: 600;
	border-bottom: 2px solid #e3e8f0;
}
td {
	color: #333;
	border-bottom: 1px solid #f0f2f7;
}
.status {
	padding: 0.2rem 0.7rem;
	border-radius: 8px;
	font-size: 0.95rem;
	font-weight: 500;
}
.status.success {
	background: #e6f9e6;
	color: #2ecc40;
}
.status.warning {
	background: #fffbe6;
	color: #ffb300;
}
.status.error {
	background: #ffeaea;
	color: #ff6b6b;
}

</style>
